# Copy to .env and fill in. .env is git-ignored; secrets are never written back to disk
# and never returned by the API (research.md ).

# --- Required. Startup fails without it, even when public read-only access is enabled.
# Generate with: openssl rand -hex 32
AGGREGATO_TOKEN=

# --- Optional, with the defaults shown.

# A second bearer token granting reads only: every state-changing request is refused with 403, so
# it cannot change settings, trigger syncs, or be exchanged for a session cookie. For sharing the
# archive in a public environment. Unset means no read-only access exists.
# AGGREGATO_READONLY_TOKEN=

# Allow the frontend and API GET/HEAD requests without a caller token. Writes and websockets still
# require authentication.
# AGGREGATO_ALLOW_UNAUTHENTICATED_READONLY=false

# Where the archive lives: the SQLite database, cached images, and uploaded import files.
AGGREGATO_DATA=./data

# Maximum retained import-file bytes per provider, including the incoming upload.
# AGGREGATO_IMPORT_QUOTA_BYTES=536870912
# Maximum retained import-file bytes across all providers, including the incoming upload.
# AGGREGATO_IMPORT_TOTAL_QUOTA_BYTES=2147483648

# Default is SQLite (WAL) inside AGGREGATO_DATA. Postgres is supported from the same setting:
#   AGGREGATO_DATABASE_URL=postgresql+asyncpg://aggregato:secret@localhost/aggregato
# The spec recommends Postgres past roughly 1M entries.
# AGGREGATO_DATABASE_URL=sqlite+aiosqlite:///./data/aggregato.db

# Optional YAML config file. Settings resolve: defaults <- this file <- ${ENV} <- database
# overrides edited in the UI. Anything set in the file is reported as file-pinned and the UI
# shows it as uneditable.
# AGGREGATO_CONFIG=./config.yaml

# Browser origins allowed to call the API cross-origin, comma-separated. Unset — the default —
# mounts no CORS middleware at all: the API serves the web UI from its own origin, and Vite
# proxies /api in development, so neither is ever cross-origin and no browser preflights them.
# Set it only for a browser client served from somewhere else. '*' is refused: the API sends a
# session cookie, and CORS forbids a wildcard origin with credentials.
# AGGREGATO_CORS_ORIGINS=https://log.example.com

# Addresses of the reverse proxies allowed to provide X-Forwarded-* headers. The container
# entrypoint defaults to loopback; replace this only with the actual trusted proxy addresses.
# AGGREGATO_FORWARDED_ALLOW_IPS=127.0.0.1

# uvicorn bind
# AGGREGATO_HOST=0.0.0.0
# AGGREGATO_PORT=8000

# The built web UI the API serves. Set by the Docker image; unset in a development checkout, where
# Vite serves the frontend itself. Unset means "API only", which is not an error.
# AGGREGATO_STATIC_DIR=./frontend/dist

# Optional directory of your own provider packages, discovered as unreviewed drop-ins .
# AGGREGATO_PROVIDER_DIR=./providers

# --- Provider credentials. Referenced from the YAML config as ${VAR}, resolved at read time.
# Nothing outbound happens until a provider is explicitly enabled .
# LISTENBRAINZ_TOKEN=
# ANILIST_TOKEN=
