# What a release ships. `export-ignore` is honoured by `git archive` and by GitHub's own generated
# source archives, so one list governs both: a release tarball carries what is needed to run
# Aggregato or build its image, and nothing that only exists to develop it.
#
# Kept deliberately: frontend/ (the image builds the SPA from source), docker/, uv.lock, alembic.ini,
# docs/ (operations.md is written for whoever is running it), README.md.

.github/          export-ignore
.gitattributes    export-ignore
.gitignore        export-ignore
.dockerignore     export-ignore

# Development-only tooling and process material.
.agents/          export-ignore
.codex/           export-ignore
.codegraph/       export-ignore
CLAUDE.md         export-ignore
CONTRIBUTING.md   export-ignore
# Cuts releases from a checkout; useless inside the artefact it produces.
scripts/          export-ignore

# The specification tree is normative for reviews, not needed to run the service. tests/ carries
# recorded fixtures and would roughly double the archive.
specs/            export-ignore
tests/            export-ignore
docker/compose.dev.yml  export-ignore
